<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>BlazeDb.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core provider for BlazeDb. UseBlazeDb() maps DbSet types onto the engine's live rows; LINQ is translated onto hash/ordered indexes with no SQL.</Description>
    <PackageTags>$(PackageTags);efcore;entityframeworkcore;linq</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazeDb\BlazeDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The translator and the plan are the provider's interesting parts and are tested directly:
         from the outside an index lookup and a scan are indistinguishable. -->
    <InternalsVisibleTo Include="BlazeDb.Tests" />
  </ItemGroup>

</Project>
